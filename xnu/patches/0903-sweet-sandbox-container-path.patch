From: port_ios lavender
Subject: [PATCH 0903] sweet: sandbox op 4 container path -> /var/tmp for appex PlugInKit

---
diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 0ed1e88..1b4c2d0 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -301,7 +301,23 @@ sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
 		printf("SWEET Sandbox: %s op %d\n", name, call);
 	}
 	switch (call) {
-	case 4:         /* container path (audit token / pid) */
+	case 4: {       /* container path (pid, flags, buf, bufsize, pad) */
+		struct {
+			uint64_t pid;
+			uint64_t flags;
+			user_addr_t buf;
+			uint64_t bufsize;
+			uint64_t pad;
+		} sc4;
+		static const char tmp_container[] = "/var/tmp";
+		if (arg != 0 && copyin(arg, &sc4, sizeof(sc4)) == 0 &&
+		    sc4.buf != 0 && sc4.bufsize >= sizeof(tmp_container)) {
+			if (copyout(tmp_container, sc4.buf, sizeof(tmp_container)) == 0) {
+				return 0;
+			}
+		}
+		return ENOENT;
+	}
 	case 0x43:      /* container expected */
 		return ENOENT;
 	default:        /* extension issue/consume (5/6) succeed: no sandbox */
