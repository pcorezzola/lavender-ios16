-	    lo == 0x9eu || lo == 0xb0u || lo == 0xb2u || lo == 0xb3u ||
-	    lo == 0xb4u || lo == 0xb5u || lo == 0xb6u || lo == 0xc0u ||
-	    lo == 0xc1u || lo == 0xc3u;
