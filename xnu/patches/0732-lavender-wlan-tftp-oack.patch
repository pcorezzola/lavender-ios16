+/* Echo every option the modem asked for; clients abort on a partial OACK. */
+static void
+wlan_tftp_oack(struct tftp_sess *s)
+{
+	static const char *keys[4] = { "blksize", "wsize", "timeoutms",
+	    "tsize" };
+	boolean_t use[4] = { TRUE, s->has_wsize, s->has_timeout,
+	    s->has_tsize };
+	uint32_t n = 4;
+
+	t_pkt[0] = 0;
+	t_pkt[1] = TFTP_OACK;
+	for (int i = 0; i < 4; i++) {
+		const char *k = keys[i];
+		uint32_t v = i == 0 ? s->blk : i == 1 ? s->wsize :
+		    i == 2 ? s->timeout : (s->write ? 0 : s->size);
+
+		if (!use[i]) {
+			continue;
+		}
+		while (*k != 0) {
+			t_pkt[n++] = (uint8_t)*k++;
+		}
+		t_pkt[n++] = 0;
+		wlan_tftp_u32(t_pkt, &n, v);
+		t_pkt[n++] = 0;
+	}
+	wlan_tftp_reply(s, n);
+}
