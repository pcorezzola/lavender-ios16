+/*
+ * 1016: MCLK0 = 24 MHz, the clock the stock power sequence (the sensor's
+ * qcom,cam-power-seq-* in the DTB) enables between the rails and the reset.
+ * MMPLL10 is 576 MHz (19.2 MHz * L=30); mclk0_src divides it by 24 with the
+ * MND divider of the RCG2, exactly the ftbl_mclk0_clk_src 24 MHz entry of
+ * mmcc-sdm660.c ("F(24000000, P_MMPLL10, 1, 1, 24)").
+ */
+#define CAM_MMCC_MMPLL10_L_VAL      0x0194u
+#define CAM_MMCC_MMPLL10_USER_CTL   0x01a0u
+#define CAM_MMCC_MMPLL10_CONFIG_CTL 0x01a8u
+#define CAM_PLL_OUTCTRL         (1u << 0)
+#define CAM_PLL_BYPASSNL        (1u << 1)
+#define CAM_PLL_RESET_N         (1u << 2)
+#define CAM_PLL_USER_MAIN_OUT   (1u << 0)
+#define CAM_MMCC_MCLK0_RCG      0x3360u
+#define CAM_RCG_M_REG           0x08u
+#define CAM_RCG_N_REG           0x0cu
+#define CAM_RCG_D_REG           0x10u
+#define CAM_MMCC_MCLK0_CBCR     0x3384u
+#define CAM_RCG_CFG_MCLK0_24MHZ 0x2301u  /* div 1 | src MMPLL10 (3) | dual */
+#define CAM_GPIO_MCLK0          32u      /* TLMM function 1 = cam_mclk */
+
+static int
+cam_mclk_on(void)
+{
+	uint32_t v;
+	unsigned i;
+
+	printf("SWEET CAM: mclk: MMPLL10 576 MHz, mclk0 24 MHz\n");
+	cam_wr(mmcc, CAM_MMCC_MMPLL10_L_VAL, 0x1eu);
+	cam_wr(mmcc, CAM_MMCC_MMPLL10_CONFIG_CTL, 0x00004289u);
+	v = cam_rd(mmcc, CAM_MMCC_MMPLL10_USER_CTL);
+	cam_wr(mmcc, CAM_MMCC_MMPLL10_USER_CTL, v | CAM_PLL_USER_MAIN_OUT);
+
+	v = cam_rd(mmcc, CAM_MMCC_MMPLL10_MODE);
+	cam_wr(mmcc, CAM_MMCC_MMPLL10_MODE, v | CAM_PLL_BYPASSNL);
+	cam_spin_us(5);
+	v = cam_rd(mmcc, CAM_MMCC_MMPLL10_MODE);
+	cam_wr(mmcc, CAM_MMCC_MMPLL10_MODE, v | CAM_PLL_RESET_N);
+	for (i = 0; i < 1000; i++) {
+		if (cam_rd(mmcc, CAM_MMCC_MMPLL10_MODE) & CAM_PLL_LOCK_DET) {
+			break;
+		}
+		cam_wait(1);
+	}
+	if (i == 1000) {
+		printf("SWEET CAM: mclk: MMPLL10 did not lock (mode %08x)\n",
+		    cam_rd(mmcc, CAM_MMCC_MMPLL10_MODE));
+		return ETIMEDOUT;
+	}
+	v = cam_rd(mmcc, CAM_MMCC_MMPLL10_MODE);
+	cam_wr(mmcc, CAM_MMCC_MMPLL10_MODE, v | CAM_PLL_OUTCTRL);
+	printf("SWEET CAM: mclk: MMPLL10 mode %08x (locked)\n",
+	    cam_rd(mmcc, CAM_MMCC_MMPLL10_MODE));
+
+	cam_wr(mmcc, CAM_MMCC_MCLK0_RCG + CAM_RCG_M_REG, 0x00000001u);
+	cam_wr(mmcc, CAM_MMCC_MCLK0_RCG + CAM_RCG_N_REG, 0x000000e8u);
+	cam_wr(mmcc, CAM_MMCC_MCLK0_RCG + CAM_RCG_D_REG, 0x000000e7u);
+	cam_wr(mmcc, CAM_MMCC_MCLK0_RCG + 0x04u, CAM_RCG_CFG_MCLK0_24MHZ);
+	v = cam_rd(mmcc, CAM_MMCC_MCLK0_RCG);
+	cam_wr(mmcc, CAM_MMCC_MCLK0_RCG, v | CAM_RCG_CMD_UPDATE);
+	for (i = 0; i < 500; i++) {
+		if (!(cam_rd(mmcc, CAM_MMCC_MCLK0_RCG) &
+		    CAM_RCG_CMD_UPDATE)) {
+			break;
+		}
+		cam_spin_us(1);
+	}
+	v = cam_rd(mmcc, CAM_MMCC_MCLK0_RCG);
+	cam_wr(mmcc, CAM_MMCC_MCLK0_RCG,
+	    (v | CAM_RCG_CMD_ROOT_EN) & ~CAM_RCG_CMD_ROOT_OFF);
+	for (i = 0; i < 1000; i++) {
+		if (!(cam_rd(mmcc, CAM_MMCC_MCLK0_RCG) &
+		    CAM_RCG_CMD_ROOT_OFF)) {
+			break;
+		}
+		cam_wait(1);
+	}
+	v = cam_rd(mmcc, CAM_MMCC_MCLK0_CBCR);
+	cam_wr(mmcc, CAM_MMCC_MCLK0_CBCR, v | CAM_CBCR_EN);
+	for (i = 0; i < 1000; i++) {
+		if (!(cam_rd(mmcc, CAM_MMCC_MCLK0_CBCR) & CAM_CBCR_CLK_OFF)) {
+			break;
+		}
+		cam_wait(1);
+	}
+	cam_wr(tlmm, CAM_GPIO_MCLK0 * 0x1000u + 4u, 0);
+	cam_wr(tlmm, CAM_GPIO_MCLK0 * 0x1000u, (1u << 2) | (2u << 6));
+	printf("SWEET CAM: mclk: rcg cmd %08x cfg %08x, cbcr %08x, pin %08x\n",
+	    cam_rd(mmcc, CAM_MMCC_MCLK0_RCG),
+	    cam_rd(mmcc, CAM_MMCC_MCLK0_RCG + 0x04u),
+	    cam_rd(mmcc, CAM_MMCC_MCLK0_CBCR),
+	    cam_rd(tlmm, CAM_GPIO_MCLK0 * 0x1000u));
+	return 0;
+}
