From: port_ios lavender
Subject: [PATCH 0352] lavender: raise the Gold cluster PLL (sweetcpul=L, capped at 0x3a = 1113.6 MHz)

ABL leaves the perf cluster at L=0x20 (614 MHz) and nothing programs the OSM. TWRP's
downstream kernel shows this chip's CPR corners (apc1): 1113.6 MHz needs 0.700 V, the same
as the lowest OPPs. Park the RCG on XO, reprogram the PLL L, wait lock, switch back.

---
ok
diff --git a/bsd/dev/santoni_sdhci.c b/bsd/dev/santoni_sdhci.c
--- a/bsd/dev/santoni_sdhci.c
+++ b/bsd/dev/santoni_sdhci.c
@@ -4576,6 +4576,101 @@
 		sweet_osm_dump_range("goldcpr", 0x179c7000ull, 0x1000);
 	}
 	printf("SWEET OSM: dump done\n");
+}
+
+/*
+ * 0352: raise the Gold (perf) cluster clock (boot-arg sweetcpul=L, PLL ref 19.2 MHz).
+ * ABL leaves L = 0x20 (614.4 MHz); the OSM that normally steps it is not programmed.
+ * TWRP's downstream kernel (CPR corner table of this very chip, read from
+ * /sys/kernel/debug/cpr3-regulator/apc1) needs only 0.700 V for 1113.6 MHz (L = 58),
+ * the same corner as the low OPPs, so one step to <= 0x3a needs no voltage change.
+ * L is capped at 0x3a. The RCG at 0x17811050/54 is parked on XO while the PLL is
+ * reprogrammed (MODE bit0 OUTCTRL, bit1 BYPASSNL, bit2 RESET_N, bit31 LOCK_DET).
+ */
+static int
+sweet_cpul_rcg_update(volatile uint32_t *cmd)
+{
+	*cmd |= 1u;
+	for (int i = 0; i < 1000; i++) {
+		if (!(*cmd & 1u)) {
+			return 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
+
+static void
+sweet_cpul(void)
+{
+	uint32_t l = 0, oldl, mode, cfg;
+	vm_offset_t pll, rcg;
+	volatile uint32_t *p, *cmd, *cf;
+	int lock = 0;
+
+	if (!PE_parse_boot_argn("sweetcpul", &l, sizeof(l)) || l == 0) {
+		return;
+	}
+	if (l > 0x3a) {
+		l = 0x3a;
+	}
+	pll = ml_io_map(0x17816000ull, 0x1000);
+	rcg = ml_io_map(0x17811000ull, 0x1000);
+	if (!pll || !rcg) {
+		printf("SWEET CPUL: no mapping\n");
+		return;
+	}
+	p = (volatile uint32_t *)pll;
+	cmd = (volatile uint32_t *)(rcg + 0x50);
+	cf = (volatile uint32_t *)(rcg + 0x54);
+	oldl = p[1];
+	mode = p[0];
+	cfg = *cf;
+	printf("SWEET CPUL: mode 0x%08x L 0x%x rcg cfg 0x%08x cmd 0x%08x -> L 0x%x\n", mode, oldl, cfg, *cmd, l);
+	if (l <= oldl || (mode & 7) != 7) {
+		printf("SWEET CPUL: nothing to do\n");
+		return;
+	}
+	/* park the cluster on XO (source 0) */
+	*cf = cfg & ~(7u << 8);
+	if (sweet_cpul_rcg_update(cmd)) {
+		*cf = cfg;
+		(void)sweet_cpul_rcg_update(cmd);
+		printf("SWEET CPUL: RCG update to XO timed out\n");
+		return;
+	}
+	/* PLL: output off, bypass, reset; program L; re-enable */
+	p[0] = mode & ~1u;
+	p[0] = mode & ~3u;
+	p[0] = mode & ~7u;
+	p[1] = l;
+	delay(5);
+	p[0] = (mode & ~7u) | 2u;
+	delay(5);
+	p[0] = (mode & ~7u) | 6u;
+	for (int i = 0; i < 2000; i++) {
+		if (p[0] & 0x80000000u) {
+			lock = 1;
+			break;
+		}
+		delay(1);
+	}
+	if (!lock) {
+		/* back to the old rate */
+		p[0] = mode & ~7u;
+		p[1] = oldl;
+		p[0] = (mode & ~7u) | 2u;
+		delay(5);
+		p[0] = (mode & ~7u) | 6u;
+		for (int i = 0; i < 2000 && !(p[0] & 0x80000000u); i++) {
+			delay(1);
+		}
+	}
+	p[0] = (p[0] & ~7u) | 7u;
+	*cf = cfg;
+	(void)sweet_cpul_rcg_update(cmd);
+	printf("SWEET CPUL: %s, mode 0x%08x L 0x%x rcg cfg 0x%08x cmd 0x%08x\n",
+	    lock ? "locked" : "LOCK FAILED (old L restored)", p[0], p[1], *cf, *cmd);
 }
 
 /*
@@ -5592,6 +5687,7 @@
 	if (!error) {
 		sdhci_speedup();        /* 0349: optional, never fails the probe */
 		sweet_osm_dump();       /* 0351: boot-arg sweetosm=1 */
+		sweet_cpul();           /* 0352: boot-arg sweetcpul=L */
 	}
 	if (!error) {
 		stage = "GPT partition";
