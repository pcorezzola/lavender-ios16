+extern void santoni_log_append(const char *c, int size);   /* bsd/dev/santoni_sdhci.c */
+extern void santoni_log_panic_flush(void);
+
+/* 0357: the panic text goes to the screen and to the persistent ring */
+static void
+sweet_panic_putc(char c)
+{
+	sweet_early_putc(c);
+	santoni_log_append(&c, 1);
+}
+
+static void
+sweet_panic_hex(unsigned long long v)
+{
+	static const char digits[] = "0123456789abcdef";
+
+	sweet_panic_putc('0');
+	sweet_panic_putc('x');
+	for (int sh = 60; sh >= 0; sh -= 4) {
+		sweet_panic_putc(digits[(v >> sh) & 0xf]);
+	}
+	sweet_panic_putc(' ');
+}
+
+/* 0357: where this CPU was: the return addresses up the frame-pointer chain (kernel text, symbolised on the Mac) */
+static void
+sweet_panic_backtrace(void)
+{
+	uintptr_t * fp = (uintptr_t *)__builtin_frame_address(0);
+	const char * title = "SWEET PANIC BT: ";
+
+	while (*title) {
+		sweet_panic_putc(*title++);
+	}
+	for (int i = 0; i < 24; i++) {
+		uintptr_t next;
+
+		if (((uintptr_t)fp & 0xf) != 0 || ((uintptr_t)fp >> 48) != 0xffff) {
+			break;
+		}
+		sweet_panic_hex((unsigned long long)fp[1]);
+		next = fp[0];
+		if (next <= (uintptr_t)fp || next - (uintptr_t)fp > 0x10000) {
+			break;
+		}
+		fp = (uintptr_t *)next;
+	}
+	sweet_panic_putc('\n');
+}
