diff --git a/bsd/dev/santoni_sdhci.c b/bsd/dev/santoni_sdhci.c
--- a/bsd/dev/santoni_sdhci.c
+++ b/bsd/dev/santoni_sdhci.c
@@ -6079,6 +6079,45 @@
 	bzero(bounce, SDHCI_BLOCK);
 	memcpy(bounce, &h, sizeof(h));
 	return santoni_sdhci_write_log_blocks(base, 1, bounce);
+}
+
+static _Atomic uint64_t santoni_log_flushed_total;     /* 0357: what the flusher has written, for the panic flush */
+
+/*
+ * 0357: called from the early panic handler with every other CPU stopped or spinning. The flusher thread cannot run
+ * then, so the panic text (appended to the ring by the handler) and the last 64 KiB before it would stay in RAM. Write
+ * them with the PIO routine directly (no mutex: the one that may be held is the reason we are here), then the header.
+ */
+void santoni_log_panic_flush(void);
+
+void
+santoni_log_panic_flush(void)
+{
+	static uint8_t hdr[SDHCI_BLOCK];
+	uint64_t base = se.sys_first_block;
+	uint64_t total = os_atomic_load(&santoni_log_total, relaxed);
+	uint64_t done = os_atomic_load(&santoni_log_flushed_total, relaxed);
+	uint64_t pos = (total > done + 65536) ? total - 65536 : done;
+	struct santoni_log_header h = { .magic = "SANTONILOG1", .version = 1, .size = SANTONI_LOG_SIZE, .total = total, .seq = 999999 };
+	int error = 0;
+
+	if (!se.log_ok || total == 0) {
+		return;
+	}
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % SANTONI_LOG_SIZE);
+		uint32_t blk = off / SDHCI_BLOCK;
+		uint64_t need = ((uint64_t)(off % SDHCI_BLOCK) + (total - pos) + SDHCI_BLOCK - 1) / SDHCI_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SANTONI_LOG_SIZE / SDHCI_BLOCK - blk)), (uint64_t)(BOUNCE_SIZE / SDHCI_BLOCK));
+
+		error = sdhci_write_pio((uint32_t)(base + 1 + blk), n, santoni_log_ring + (uint64_t)blk * SDHCI_BLOCK);
+		pos += (uint64_t)(blk + n) * SDHCI_BLOCK - off;
+	}
+	if (!error) {
+		bzero(hdr, SDHCI_BLOCK);
+		memcpy(hdr, &h, sizeof(h));
+		(void)sdhci_write_pio((uint32_t)base, 1, hdr);
+	}
 }
 
 static void
@@ -6159,6 +6198,7 @@
 			    herr ? "failed" : "ok");
 		}
 		flushed = total;
+		os_atomic_store(&santoni_log_flushed_total, flushed, relaxed);
 	}
 }
 
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
