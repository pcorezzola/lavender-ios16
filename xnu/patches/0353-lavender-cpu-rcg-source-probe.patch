From: port_ios lavender
Subject: [PATCH 0353] lavender: probe the Gold RCG sources and time each (sweetcpuprobe=1)

L=0x3a (0352) did not speed the cores up: find which RCG source actually runs them.

---
ok
diff --git a/bsd/dev/santoni_sdhci.c b/bsd/dev/santoni_sdhci.c
--- a/bsd/dev/santoni_sdhci.c
+++ b/bsd/dev/santoni_sdhci.c
@@ -4656,6 +4656,72 @@
 	(void)sweet_cpul_rcg_update(cmd);
 	printf("SWEET CPUL: %s, mode 0x%08x L 0x%x rcg cfg 0x%08x cmd 0x%08x\n",
 	    "done", p[0], p[1], *cf, *cmd);
+}
+
+/*
+ * 0353: boot-arg sweetcpuprobe=1. With the Gold PLL moved to L = 0x3a (0352) the cores did not get
+ * faster, so the RCG at 0x17811050 (CFG 0x401 = source 4) may not be fed by that PLL. Try each source
+ * 0..7 in turn (an update that does not complete leaves the old source running), time a dependent-add
+ * loop against the generic timer, print the MHz, and put the original CFG back.
+ */
+static uint32_t
+sweet_cpuprobe_mhz(void)
+{
+	uint64_t f, t0, t1, n = 4000000, x = 1;
+
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(f));
+	if (f == 0) {
+		f = 19200000ull;       /* firmware left CNTFRQ unset */
+	}
+	__asm__ volatile ("isb; mrs %0, cntvct_el0" : "=r"(t0));
+	for (uint64_t i = 0; i < n; i++) {
+		__asm__ volatile ("add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1" : "+r"(x));
+	}
+	__asm__ volatile ("isb; mrs %0, cntvct_el0" : "=r"(t1));
+	if (t1 == t0) {
+		return 0;
+	}
+	return (uint32_t)((4 * n * f) / ((t1 - t0) * 1000000ull));
+}
+
+static void
+sweet_cpuprobe(void)
+{
+	uint32_t on = 0;
+	vm_offset_t rcg;
+	volatile uint32_t *cmd, *cf;
+	uint32_t cfg;
+
+	if (!PE_parse_boot_argn("sweetcpuprobe", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	rcg = ml_io_map(0x17811000ull, 0x1000);
+	if (!rcg) {
+		return;
+	}
+	cmd = (volatile uint32_t *)(rcg + 0x50);
+	cf = (volatile uint32_t *)(rcg + 0x54);
+	cfg = *cf;
+	printf("SWEET CPUPROBE: cfg 0x%08x current %u MHz\n", cfg, sweet_cpuprobe_mhz());
+	for (uint32_t src = 0; src < 8; src++) {
+		int e;
+
+		if (src == ((cfg >> 8) & 7)) {
+			continue;
+		}
+		*cf = (cfg & ~(7u << 8)) | (src << 8);
+		e = sweet_cpul_rcg_update(cmd);
+		if (e) {
+			printf("SWEET CPUPROBE: src %u: update timed out\n", src);
+		} else {
+			printf("SWEET CPUPROBE: src %u: %u MHz\n", src, sweet_cpuprobe_mhz());
+		}
+		*cf = cfg;
+		if (sweet_cpul_rcg_update(cmd)) {
+			printf("SWEET CPUPROBE: restore timed out\n");
+		}
+	}
+	printf("SWEET CPUPROBE: done, cfg 0x%08x %u MHz\n", *cf, sweet_cpuprobe_mhz());
 }
 
 /*
@@ -5673,6 +5739,7 @@
 		sdhci_speedup();        /* 0349: optional, never fails the probe */
 		sweet_osm_dump();       /* 0351: boot-arg sweetosm=1 */
 		sweet_cpul();           /* 0352: boot-arg sweetcpul=L */
+		sweet_cpuprobe();       /* 0353: boot-arg sweetcpuprobe=1 */
 	}
 	if (!error) {
 		stage = "GPT partition";
