 static int ring_wait_polls = 300;
 
+/* Read from the panic path without locks or GPU MMIO. High word: stream number.
+ * Low word: 1 accepted, 2 WPTR written, 3 RPTR caught up, 4 fence observed. */
+static uint64_t lav_submit_progress;
+uint64_t lavender_gpu_last_progress(void);
+
+uint64_t
+lavender_gpu_last_progress(void)
+{
+	return __atomic_load_n(&lav_submit_progress, __ATOMIC_RELAXED);
+}
+
+static inline void
+lav_mark_submit(uint32_t seq, uint32_t stage)
+{
+	__atomic_store_n(&lav_submit_progress, ((uint64_t)seq << 32) | stage, __ATOMIC_RELAXED);
+}
+
 /* Publish the packets and wait for the CP read pointer to catch up. */
 static int
-ring_submit(const char *what)
+ring_submit_trace(const char *what, uint32_t seq)
 {
 	uint32_t rptr = 0;
 
 	flush_dcache64((addr64_t)ring_pa, RING_BYTES, TRUE);
 	wr(gpu, A5_CP_RB_WPTR, ring_wptr);
+	if (seq) {
+		lav_mark_submit(seq, 2);
+	}
 	for (int i = 0; i < ring_wait_polls; i++) {
 		rptr = rd(gpu, A5_CP_RB_RPTR);
 		if (rptr == ring_wptr) {
+			if (seq) {
+				lav_mark_submit(seq, 3);
+			}
 			printf("LAVGPU: %s consumed: RPTR %u WPTR %u after %d ms\n",
 			    what, rptr, ring_wptr, i * 10);
 			return 0;
@@ -1033,6 +1056,12 @@
 	    "%08x AHB_ERR %08x\n", what, rptr, ring_wptr, rd(gpu, A5_RBBM_STATUS),
 	    rd(gpu, A5_RBBM_INT_0_STATUS), rd(gpu, A5_RBBM_AHB_ERR_STATUS));
 	return -1;
+}
+
+static int
+ring_submit(const char *what)
+{
+	return ring_submit_trace(what, 0);
 }
 
