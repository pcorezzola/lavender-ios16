diff --git a/bsd/dev/lavender_wlan.c b/bsd/dev/lavender_wlan.c
index 61a97aa..872a627 100644
--- a/bsd/dev/lavender_wlan.c
+++ b/bsd/dev/lavender_wlan.c
@@ -3077,6 +3077,11 @@ wlan_glink_start(struct smem_part_hdr *part)
 #define RPM_RSC_LDOA      0x616f646cu   /* "ldoa" */
 #define RPM_RSC_CLK_BUF_A 0x616b6c63u   /* "clka" */
 #define RPM_KEY_PCCB      0x62636370u   /* "pccb" pin-ctrl clk buffer */
+#define GICD_PA           0x17a00000u
+#define GICD_SIZE         0x10000u
+#define GICD_ISPENDR6     0x218u        /* GIC IDs 192..223 */
+#define GICD_ICPENDR6     0x298u
+#define RPM_GIC_BIT       0x100u        /* SPI 168 -> ID 200 -> bit 8 */
 #define RPM_KEY_SWEN      0x6e657773u   /* "swen" */
 #define RPM_KEY_PCEN      0x6e656370u   /* "pcen" */
 #define RPM_KEY_PCMD      0x646d6370u   /* "pcmd" */
@@ -3414,31 +3419,21 @@ wlan_rails_on(void)
 		return;
 	}
 	/*
-	 * 0760: the whole RPM sequence now runs after the modem auth (the
-	 * pre-auth kick panicked, 0759). VERSION, then a short wait so any
-	 * asynchronous platform error from the kick lands before we touch the
-	 * RX descriptor, then poll for the RPM's VERSION/ACK, then OPEN and
-	 * wait for OPEN_ACK.
+	 * 0762: blind handshake, no RX FIFO reads until the GIC latch says
+	 * the RPM has data. 0758 (the only build that survived) never read
+	 * R2AP after kicking; 0759 died in the poll and 0760/0761 died on
+	 * the first read, so an AP read while the AOSS SRAM is not awake
+	 * returns a platform error. Linux reads the FIFO only inside the
+	 * RPM IRQ handler (SPI 168). The transport table in
+	 * glink_smem_native_xprt.c negotiates GLINK version 1.
 	 */
 	printf("SWEET RPM: send version\n");
-	rpm_cmd(0, 0, 0);              /* VERSION with the IPC kick */
-	wlan_wait(50);
-	printf("SWEET RPM: version sent, rx %x %x\n",
-	    rpm_rd32(rpm_rx_off), rpm_rd32(rpm_rx_off + 4));
-	for (i = 0; i < 200 && !rpm_ver; i++) {
-		rpm_poll();
-		if ((i % 40) == 0) {
-			printf("SWEET RPM: ver wait %u avail %u\n", i,
-			    rpm_rx_avail());
-		}
-		wlan_wait(1);
-	}
-	printf("SWEET RPM: ver done ver %u open %u avail %u\n", rpm_ver,
-	    rpm_open, rpm_rx_avail());
-	if (!rpm_ver) {
-		printf("SWEET RPM: no VERSION from the RPM\n");
-		return;
-	}
+	rpm_cmd(0, 1, 0);              /* VERSION v1 with the IPC kick */
+	wlan_wait(100);
+	printf("SWEET RPM: blind ack\n");
+	rpm_cmd(1, 1, 0);              /* VERSION_ACK v1 */
+	wlan_wait(100);
+	printf("SWEET RPM: blind open\n");
 	{
 		uint8_t open[32];
 		uint32_t name_len = sizeof(RPM_CHAN);
@@ -3452,21 +3447,8 @@ wlan_rails_on(void)
 		printf("SWEET RPM: open %s (%u bytes)\n", RPM_CHAN, olen);
 		(void)rpm_tx(open, olen, NULL, 0);
 	}
-	wlan_wait(20);
-	for (i = 0; i < 300 && !rpm_open; i++) {
-		rpm_poll();
-		if ((i % 50) == 0) {
-			printf("SWEET RPM: open wait %u avail %u\n", i,
-			    rpm_rx_avail());
-		}
-		wlan_wait(1);
-	}
-	if (!rpm_open) {
-		printf("SWEET RPM: no OPEN_ACK (rx head %x tail %x avail %u)\n",
-		    rpm_rd32(rpm_rx_off + 4), rpm_rd32(rpm_rx_off),
-		    rpm_rx_avail());
-		return;
-	}
+	wlan_wait(200);
+	printf("SWEET RPM: blind handshake done\n");
 	/*
 	 * ath10k's vreg order for this node: 0.8 (swen), 1.8 (pcen), 1.3
 	 * (pcen), 3.3 (pcen). Values are the min of vdd-*-config from the
@@ -3514,9 +3496,41 @@ wlan_rails_on(void)
 			    RPM_SET_SLEEP, kc, vc, 1);
 		}
 	}
-	for (i = 0; i < 100; i++) {
-		rpm_poll();
-		wlan_wait(1);
+	/*
+	 * 0762: read R2AP only when the GIC reports the RPM's edge pending
+	 * (SPI 168 -> GIC ID 200 -> ISPENDR6 bit 8). Linux reads the FIFO
+	 * only from this interrupt's handler; polling the pending bit is the
+	 * same gate without IOKit. The edge latches even while the SPI is
+	 * disabled, so no GIC enable is needed.
+	 */
+	{
+		vm_offset_t gicd = ml_io_map(GICD_PA, GICD_SIZE);
+
+		if (gicd == 0) {
+			printf("SWEET RPM: GICD map failed\n");
+		} else {
+			uint32_t pend = 0;
+
+			for (i = 0; i < 500; i++) {
+				pend = *(volatile uint32_t *)(gicd +
+				    GICD_ISPENDR6);
+				if ((pend & RPM_GIC_BIT) != 0) {
+					break;
+				}
+				wlan_wait(1);
+			}
+			if ((pend & RPM_GIC_BIT) != 0) {
+				printf("SWEET RPM: gic irq at %u\n", i);
+				*(volatile uint32_t *)(gicd +
+				    GICD_ICPENDR6) = RPM_GIC_BIT;
+				wlan_mb();
+				rpm_poll();
+				printf("SWEET RPM: gic read ver %u open %u\n",
+				    rpm_ver, rpm_open);
+			} else {
+				printf("SWEET RPM: gic no irq (%x)\n", pend);
+			}
+		}
 	}
 	printf("SWEET RPM: rails voted\n");
 }
