From: port_ios lavender
Subject: [PATCH 0348] lavender: sysctl kern.sweet_fb_shot, a screenshot of the scanned frame over ssh

The phone has no camera-free way to see the panel when the GPU composes the
frame (CARenderServerRenderDisplay comes out black then). kern.sweet_fb_shot
returns a copy of what the MDP scans now (page-flip buffer, last directly
scanned frame, console shadow or panel memory, in that order), every scale-th
pixel (kern.sweet_fb_shot_scale, 2..8, default 3), as a 16-byte header
('SHOT', width, height, bytes per row) plus BGRA rows. Root only, read only.
The bergamota tool sweetshot reads exactly this format. Modelled on bergamota
patch 0224, rewritten for this driver (no zero-copy path here).

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -131,6 +131,9 @@
 
 class IOMobileFramebufferUserClient;
 
+class AppleCLCD;
+static AppleCLCD *sweet_fb_shot_fb;     /* the framebuffer kern.sweet_fb_shot reads (patch 0348) */
+
 class AppleCLCD : public IOMobileFramebuffer {
 	OSDeclareDefaultStructors(AppleCLCD);
 
@@ -458,6 +461,7 @@
 	setProperty("external", false);
 	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
 	registerService();
+	__atomic_store_n(&sweet_fb_shot_fb, this, __ATOMIC_RELEASE);    /* kern.sweet_fb_shot (patch 0348) */
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
 	return true;
@@ -1312,4 +1316,45 @@
 	}
 	return ret;
 }
+/*
+ * Screenshot of what the panel scans now (patch 0348), for testing over ssh. The sysctl kern.sweet_fb_shot
+ * (bsd/dev/lavender_gpu.c) asks for a copy keeping every scale-th pixel in both directions: BGRA rows of
+ * *ow * 4 bytes. Source, as fadeStep() picks it: the page-flip buffer the MDP scans, else the last directly
+ * scanned frame, else the console shadow, else the panel memory. Reads race the next frame: a screenshot may
+ * mix two frames, nothing worse.
+ */
+extern "C" int sweet_fb_shot_copy(uint8_t *dst, size_t cap, uint32_t scale, uint32_t *ow, uint32_t *oh);
+
+int
+sweet_fb_shot_copy(uint8_t *dst, size_t cap, uint32_t scale, uint32_t *ow, uint32_t *oh)
+{
+	AppleCLCD *fb = __atomic_load_n(&sweet_fb_shot_fb, __ATOMIC_ACQUIRE);
+	if (fb == NULL || scale == 0 || fb->fPixels == 0) {
+		return ENODEV;
+	}
+	IOLockLock(fb->fLock);
+	bool front = fb->fFlip[0] != NULL && fb->fScanPhys == fb->fFlipPhys[fb->fFlipIdx];
+	const uint8_t *src = front ? (const uint8_t *)fb->fFlip[fb->fFlipIdx]->getBytesNoCopy() :
+	    fb->fLastVA ? fb->fLastVA :
+	    (fb->fConsShown && fb->fCons != NULL) ? (const uint8_t *)fb->fCons->getBytesNoCopy() :
+	    (const uint8_t *)fb->fPixels;
+	uint32_t stride = (!front && fb->fLastVA) ? fb->fLastStride : fb->fRowBytes;
+	uint32_t w = fb->fWidth, h = fb->fHeight;
+	IOLockUnlock(fb->fLock);
+	uint32_t cw = w / scale, ch = h / scale;
+	if (src == NULL || cw == 0 || ch == 0 || (size_t)cw * ch * 4 > cap) {
+		return ENOSPC;
+	}
+	for (uint32_t y = 0; y < ch; y++) {
+		const uint32_t *in = (const uint32_t *)(src + (uint64_t)(y * scale) * stride);
+		uint32_t *out = (uint32_t *)(dst + (size_t)y * cw * 4);
+		for (uint32_t x = 0; x < cw; x++) {
+			out[x] = in[x * scale];
+		}
+	}
+	*ow = cw;
+	*oh = ch;
+	return 0;
+}
+
 #endif /* SWEET */
diff --git a/bsd/dev/lavender_gpu.c b/bsd/dev/lavender_gpu.c
--- a/bsd/dev/lavender_gpu.c
+++ b/bsd/dev/lavender_gpu.c
@@ -36,6 +36,8 @@
 #include <sys/fcntl.h>
 #include <sys/uio.h>
 #include <sys/kauth.h>
+#include <sys/sysctl.h>
+#include <kern/kalloc.h>
 #include <arm/caches_internal.h>
 #include <vm/memory_types.h>
 #include <vm/pmap.h>
@@ -2839,6 +2841,56 @@
 lavender_gpu_probe(void)
 {
 	return 0;
+}
+
+
+/*
+ * sysctl kern.sweet_fb_shot (patch 0348): a screenshot of what the panel scans now, for testing over ssh
+ * (sweetshot). Root only. 16-byte header, little endian: 'SHOT' (0x544f4853), width, height, bytes per row
+ * (width * 4); then BGRA rows. kern.sweet_fb_shot_scale (2..8, default 3) keeps every n-th pixel in both
+ * directions. Same format as the bergamota tools' sweetshot reads.
+ */
+extern int sweet_fb_shot_copy(uint8_t *dst, size_t cap, uint32_t scale, uint32_t *ow, uint32_t *oh);
+
+static unsigned int sweet_fb_shot_scale = 3;
+SYSCTL_UINT(_kern, OID_AUTO, sweet_fb_shot_scale, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_fb_shot_scale, 0,
+    "screenshot downscale for kern.sweet_fb_shot, 2..8");
+
+#define SWEET_FB_SHOT_MAXW 1280
+#define SWEET_FB_SHOT_MAXH 2560
+
+static int
+sweet_fb_shot_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint32_t scale = sweet_fb_shot_scale, w = 0, h = 0;
+	if (scale < 2 || scale > 8) {
+		scale = 3;
+	}
+	size_t cap = 16 + (size_t)(SWEET_FB_SHOT_MAXW / scale) * (SWEET_FB_SHOT_MAXH / scale) * 4;
+
+	if (req->oldptr == USER_ADDR_NULL) {
+		return SYSCTL_OUT(req, NULL, cap);
+	}
+	if (req->newptr != USER_ADDR_NULL || !kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	uint8_t *buf = kalloc_data(cap, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	int err = sweet_fb_shot_copy(buf + 16, cap - 16, scale, &w, &h);
+	if (err == 0) {
+		uint32_t hdr[4] = { 0x544f4853u, w, h, w * 4 };
+		memcpy(buf, hdr, sizeof(hdr));
+		err = SYSCTL_OUT(req, buf, 16 + (size_t)w * h * 4);
+	}
+	kfree_data(buf, cap);
+	return err;
 }
 
+SYSCTL_PROC(_kern, OID_AUTO, sweet_fb_shot,
+    CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0, sweet_fb_shot_sysctl, "S",
+    "screenshot of the scanned frame: 16-byte header + BGRA");
+
 #endif
