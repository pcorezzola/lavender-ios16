 /* Publish the packets and wait for the CP read pointer to catch up. */
+/*
+ * 0367: only what was written since the last submit is flushed (the ring is 128 KB now and the service submits
+ * hundreds of times a frame), and the "consumed" line is printed only for the first submits or when the wait was
+ * long: a console line per submit cost more than the GPU's work.
+ */
+static uint32_t ring_flushed;
+static uint32_t ring_nsubmit;
+
+static void
+ring_flush_written(void)
+{
+	uint32_t from = (ring_flushed * 4u) & ~63u, to = (ring_wptr * 4u + 63u) & ~63u;
+
+	if (to > RING_BYTES) {
+		to = RING_BYTES;
+	}
+	if (ring_wptr >= ring_flushed) {
+		flush_dcache64((addr64_t)(ring_pa + from), to - from, TRUE);
+	} else {
+		flush_dcache64((addr64_t)(ring_pa + from), RING_BYTES - from, TRUE);
+		flush_dcache64((addr64_t)ring_pa, to, TRUE);
+	}
+	ring_flushed = ring_wptr;
+}
