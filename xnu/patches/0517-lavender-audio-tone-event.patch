diff --git a/bsd/dev/lavender_audio.c b/bsd/dev/lavender_audio.c
index 34a458b..5b4fcb5 100644
--- a/bsd/dev/lavender_audio.c
+++ b/bsd/dev/lavender_audio.c
@@ -420,6 +420,7 @@ static unsigned glink_tx_msgs, glink_rx_msgs;
 static unsigned glink_intent_log;
 static uint32_t adm_status, adm_copp;
 static uint32_t asm_map_handle, asm_map_status;
+static volatile uint32_t asm_write_done;
 
 static inline uint32_t
 audio_rd(vm_offset_t base, uint32_t off)
@@ -2321,6 +2322,9 @@ glink_rx_one(void)
 			const struct apr_hdr *a =
 			    (const struct apr_hdr *)(const void *)buf;
 
+			if (a->opcode == 0x00010D99u) {
+				asm_write_done = 1;
+			}
 			printf("SWEET AUDIO: APR rx src %u/%u dst %u/%u "
 			    "opcode %08x token %u len %u\n", a->src_svc,
 			    a->src_domain, a->dest_svc, a->dest_domain,
@@ -2750,7 +2754,7 @@ audio_asm_tone(void)
 		uint32_t property;
 		uint32_t low, high, size;
 	} __attribute__((packed)) map = {
-		3, 1, 0, 0, 0, 65536
+		3, 1, 0, 0, 0, 16384
 	};
 	uint32_t wr[8];
 	uint32_t ms;
@@ -2761,18 +2765,18 @@ audio_asm_tone(void)
 	if (audio_step < 13 || audio_step > 14) {
 		return;
 	}
