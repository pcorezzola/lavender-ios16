+static int
+cam_pad_is_lv_mv(const struct cam_pad *pad)
+{
+	return pad->subtype >= CAM_PMIC_GPIO_SUBTYPE_LV &&
+	    pad->subtype <= CAM_PMIC_GPIO_SUBTYPE_MV_VIN3_CLK;
