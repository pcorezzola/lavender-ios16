+	 * waited for the same way.
 	 */
-	printf("SWEET RPM: phase1 version\n");
+	gicd = ml_io_map(GICD_PA, GICD_SIZE);
+	if (gicd == 0) {
+		printf("SWEET RPM: GICD map failed\n");
+		return;
+	}
+	printf("SWEET RPM: v1 version\n");
 	rpm_cmd(0, 1, 0);              /* VERSION v1 + IPC kick */
