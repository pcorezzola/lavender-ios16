+
+		if ((pend & RPM_GIC_BIT) != 0) {
+			*(volatile uint32_t *)(gicd + GICD_ICPENDR6) = RPM_GIC_BIT;
+			wlan_mb();
+			printf("SWEET RPM: ver irq %u\n", i);
+			rpm_poll();
+		}
+		if (!rpm_ver) {
+			wlan_wait(1);
+		}
+	}
+	printf("SWEET RPM: ver state %u\n", rpm_ver);
+	if (!rpm_ver) {
+		printf("SWEET RPM: no version, stop\n");
+		return;
+	}
+	{
