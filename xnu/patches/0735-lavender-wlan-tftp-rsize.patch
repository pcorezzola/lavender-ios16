+/* Send up to wsize DATA blocks without waiting for each ACK. */
+static void
+wlan_tftp_window(struct tftp_sess *s, uint32_t from)
+{
+	uint32_t n = s->has_wsize ? s->wsize : 1;
+
+	if (n < 1) {
+		n = 1;
+	}
+	if (n > 16) {
+		n = 16;
+	}
+	for (uint32_t k = 0; k < n; k++) {
+		wlan_tftp_data(s, from + k);
+		if (s->last) {
+			break;
+		}
+	}
+}
